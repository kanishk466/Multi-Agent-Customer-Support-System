    "@qdrant/js-client-rest": "^1.19.0",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
